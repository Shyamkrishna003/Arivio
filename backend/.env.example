# ARIVIO Backend Environment
# Copy to .env and update values

# Application
APP_NAME=ARIVIO
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://arivio:arivio_dev@localhost:5433/arivio

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173

# AI (set when ready)
AI_PROVIDER=groq
AI_API_KEY=            # leave blank to run without AI (rule-based reports)
AI_MODEL=openai/gpt-oss-20b

# OCR
OCR_PROVIDER=tesseract

# External Data Sources
OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/api/v2

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
