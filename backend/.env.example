# ARIVIO Backend Environment
# Copy to .env and update values

# Application
APP_NAME=ARIVIO
DEBUG=true

# Database
#
# A hosted provider's URL can be pasted in exactly as the dashboard gives it,
# `postgresql://...?sslmode=require` and all: app/db/url.py names the asyncpg
# driver and translates libpq's TLS parameters, for this app and for Alembic.
DATABASE_URL=postgresql+asyncpg://arivio:arivio_dev@localhost:5433/arivio

# Connection pool. The defaults suit a managed free tier, whose connection
# ceiling is far below a local Postgres's. Raise on a dedicated database.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Set false behind a TRANSACTION-mode pooler — Supabase's port 6543, Supavisor,
# PgBouncer in transaction pooling. Those move a connection between clients
# between statements, so prepared statements vanish mid-session and asyncpg
# fails with an error that reads like a bug rather than a config choice.
# Session-mode poolers (port 5432) and direct connections want true.
DATABASE_PREPARED_STATEMENTS=true

# Redis
#
# Optional: every cache operation degrades to a miss, so the app runs without
# it. The OCR confirmation screen does rely on it to survive a page reload.
# A hosted Redis gives a TLS URL — rediss://default:<token>@<host>:6379
REDIS_URL=redis://localhost:6379/0

# JWT Auth
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — browser origins allowed to call the API cross-origin.
#
# Either a comma-separated list or a JSON array; a trailing slash is trimmed
# for you, since an Origin header never carries a path.
#   CORS_ORIGINS=https://arivio.vercel.app,http://localhost:5173
#   CORS_ORIGINS=["https://arivio.vercel.app","http://localhost:5173"]
#
# Only consulted when a request actually arrives from another origin. Behind a
# proxy that serves the frontend and forwards /api to this backend, the
# browser's calls are same-origin and never reach this setting at all.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI providers ──
#
# Model calls walk a chain and take the first success:
#
#   gemini ──▶ groq ──▶ cerebras ──▶ openrouter ──▶ rule-based fallback
#
# A provider with no key is skipped, not failed, so you only configure the
# ones you have. The rule-based fallback is reached only when EVERY provider
# has failed — before the chain existed, one transient error was enough.
AI_PROVIDER_CHAIN=gemini,groq,cerebras,openrouter

# Per-provider keys. A key is only ever offered to the provider it belongs to.
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
OPENROUTER_API_KEY=      # https://openrouter.ai/keys — free models available
OPENAI_API_KEY=

# Per-provider model overrides. Blank uses the default for that provider;
# there is deliberately no global override, because a model name is not
# portable between providers.
GEMINI_MODEL=            # default: gemini-3.5-flash-lite (~3s, measured fastest)
GROQ_MODEL=              # default: openai/gpt-oss-20b
CEREBRAS_MODEL=          # default: llama-3.3-70b
OPENROUTER_MODEL=        # default: meta-llama/llama-3.3-70b-instruct:free

# Per-attempt timeout, so a stalled provider is abandoned for the next one
# rather than waited out.
AI_TIMEOUT=30

# ── Legacy single-provider settings ──
# Still honoured for existing deployments: AI_API_KEY is used for whichever
# provider AI_PROVIDER names, and that provider is appended to the chain.
# Prefer the per-provider keys above.
AI_PROVIDER=groq
AI_API_KEY=              # leave blank to run without AI (rule-based reports)
AI_MODEL=openai/gpt-oss-20b

# OCR — reading product labels from photos
#
# auto      use a vision model when one is configured, else tesseract.
#           Only selects gemini/openai on its own; Groq vision availability
#           varies by account, so Groq must be named explicitly below.
# gemini    strongest cheap OCR — recommended
# openai    strong, best strict-JSON support
# groq      fastest; set OCR_MODEL to a vision model YOUR account lists
# tesseract local, no API key, no parsing — weakest on real packaging
OCR_PROVIDER=auto
# Both fall back to AI_API_KEY / a per-provider default when blank, so a
# single-provider setup needs neither. Set them to read labels on Gemini while
# generating reports on something else:
#   OCR_PROVIDER=gemini
#   OCR_API_KEY=<your Google AI Studio key>
OCR_API_KEY=
# Leave blank for the per-provider default (Gemini: gemini-3.5-flash-lite,
# which reads labels as accurately as the full flash model at a tenth of the
# latency). Set gemini-3.6-flash if your labels are unusually hard.
#
# Google retires Gemini models on a schedule. If reads start failing, list
# what your key can actually reach:
#   curl -H "Authorization: Bearer $OCR_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/openai/models
OCR_MODEL=

# External Data Sources
OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/api/v2

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Health context (lab reports)
#
# Fernet key encrypting extracted health markers at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# LEAVE BLANK to disable health documents entirely — the feature fails closed
# rather than storing blood test results in plaintext. Losing a key that has
# been used makes that data permanently unreadable; back it up like a password.
HEALTH_ENCRYPTION_KEY=
